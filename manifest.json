{
  "manifest_version": 3,
  "name": "Rolles Mobile Assistant",
  "version": "2.0.0",
  "description": "Assistente de produtividade para projetos web.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*"
  ],
  "action": {
    "default_title": "Rolles Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
